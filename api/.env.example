# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
PORT=5000
# Comma-separated list of allowed browser origins in production
ALLOWED_ORIGINS=https://hrt-ai-inspection-system.vercel.app

# --- Authentication and role-based access control ---
# Secret used to sign session tokens: at least 16 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
# Administrator accounts exist ONLY here (never through the API or the sign-up form). On every start each
# listed account is created, or repaired and given the password below. Use a JSON array on one line:
#   ADMIN_ACCOUNTS=[{"email":"you@example.com","password":"a-long-password","name":"Your Name"}]
ADMIN_ACCOUNTS=
# A single account can be given with these two instead (or in addition):
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Anyone may sign up and receives the read-only Viewer role; set to false to close sign-up
ALLOW_REGISTRATION=true
# Set to false ONLY for local development to skip all checks
AUTH_ENABLED=true

# --- AI assistant (optional) ---
# Free key from Google AI Studio. Keep it ONLY here and in the host's environment settings, never in the repo.
# The assistant stays switched off while this is empty. Note: on the free plan Google may use submitted content to
# improve its products, so the assistant only ever receives defect data (no names, emails, images or notes).
GEMINI_API_KEY=
# Only free-tier models are used (gemini-3.5-flash-lite, gemini-3.1-flash-lite, gemini-3.6-flash, gemini-3.8-flash,
# gemini-4-hydrogen). A non-free name here is ignored with a warning. Set GEMINI_ALLOW_PAID=true to lift that.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.6-flash
GEMINI_ALLOW_PAID=false
# Questions allowed per minute (free plans have low limits)
ASSISTANT_RPM_USER=8
ASSISTANT_RPM_GLOBAL=12

# --- Backup AI provider: Groq (optional, free plan) ---
# Create a key at https://console.groq.com/keys . When both keys are set, Gemini is tried first and Groq takes over if Gemini
# is at its limit or down. Order can be changed with ASSISTANT_PROVIDERS (default gemini,groq).
GROQ_API_KEY=
# Free production models with tool use: openai/gpt-oss-20b (default) or openai/gpt-oss-120b. Other names are ignored.
GROQ_MODEL=openai/gpt-oss-20b
ASSISTANT_PROVIDERS=gemini,groq
